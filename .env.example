# Environment Configuration for High Performance Transaction Processing System

# Application
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# SQLite Database (Async URL for FastAPI, Sync URL for Alembic)
DATABASE_URL=sqlite+aiosqlite:///./data/transactions.db
SYNC_DATABASE_URL=sqlite:///./data/transactions.db

# Redis Queue
# Use redis://localhost:6379/0 for standalone/Docker, or fakeredis:// for self-contained testing
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=transaction_processing_queue

# Mock Posting Service
MOCK_POSTING_SERVICE_URL=http://localhost:8080
POSTING_REQUEST_TIMEOUT_SECONDS=15.0

# Retry & Recovery Policies
MAX_RETRY_ATTEMPTS=5
INITIAL_BACKOFF_SECONDS=1.0
MAX_BACKOFF_SECONDS=30.0
BACKOFF_MULTIPLIER=2.0
JITTER_ENABLED=true

# Outbox & Dispatcher Settings
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=0.1

# Worker & Reconciliation Settings
WORKER_CONCURRENCY=5
WORKER_POLL_TIMEOUT_SECONDS=1.0
PROCESSING_LEASE_TIMEOUT_SECONDS=30.0
RECONCILIATION_INTERVAL_SECONDS=5.0
VERIFICATION_WINDOW_SECONDS=12.0
