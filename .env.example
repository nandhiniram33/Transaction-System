# ============================================================
# High-Performance Transaction Processing System — Environment Template
# Copy to .env and adjust for your environment.
# ============================================================

# Application
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# -------------------------------------------------------
# DATABASE — choose ONE backend:
# -------------------------------------------------------

# Option A: SQLite WAL (default, zero-infrastructure, ~65–126 req/sec)
DATABASE_URL=sqlite+aiosqlite:///./data/transactions.db
SYNC_DATABASE_URL=sqlite:///./data/transactions.db

# Option B: PostgreSQL via asyncpg (~500–1,000+ req/sec)
# Requires: pip install asyncpg psycopg2-binary
# Requires: running PostgreSQL server (see docker-compose.yml)
# DATABASE_URL=postgresql+asyncpg://txuser:txpass@localhost:5432/transactions
# SYNC_DATABASE_URL=postgresql+psycopg2://txuser:txpass@localhost:5432/transactions

# PostgreSQL connection pool settings (ignored for SQLite)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE_SECONDS=300

# -------------------------------------------------------
# Redis Queue
# -------------------------------------------------------
# Use redis://localhost:6379/0 for standalone/Docker, or fakeredis:// for local dev
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=transaction_processing_queue

# Mock Posting Service
MOCK_POSTING_SERVICE_URL=http://localhost:8080
POSTING_REQUEST_TIMEOUT_SECONDS=15.0

# Retry & Recovery Policies
MAX_RETRY_ATTEMPTS=5
INITIAL_BACKOFF_SECONDS=1.0
MAX_BACKOFF_SECONDS=30.0
BACKOFF_MULTIPLIER=2.0
JITTER_ENABLED=true

# Outbox & Dispatcher Settings
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=0.1
OUTBOX_RETENTION_SECONDS=86400
CLEANUP_INTERVAL_SECONDS=300.0

# Worker & Reconciliation Settings
WORKER_CONCURRENCY=10
WORKER_POLL_TIMEOUT_SECONDS=1.0
PROCESSING_LEASE_TIMEOUT_SECONDS=20.0
RECONCILIATION_INTERVAL_SECONDS=2.0
VERIFICATION_WINDOW_SECONDS=12.0
QUEUE_OVERFLOW_MAX_OUTBOX=50000
